    "examples": {
      "groups": [
        {
          "description": "Example request",
          "examples": [
            {
              "codeblock": {
                "tabs": [
                  {
                    "title": "shell",
                    "language": "shell",
                    "code": "curl --request POST \\\n     --url https://api.example.com/v1/notes \\\n     --header 'accept: application/json' \\\n     --header 'content-type: application/json' \\\n     --data '\n{\n  \"title\": \"string\",\n  \"tags\": {\n    \"property1\": \"string\",\n    \"property2\": \"string\"\n  },\n  \"extra\": {\n    \"property1\": null,\n    \"property2\": null\n  },\n  \"closed\": {\n    \"a\": \"string\"\n  },\n  \"labels\": {\n    \"property1\": {\n      \"color\": \"string\"\n    },\n    \"property2\": {\n      \"color\": \"string\"\n    }\n  },\n  \"multi\": {\n    \"property1\": \"string\",\n    \"property2\": \"string\"\n  }\n}\n'"
                  },
                  {
                    "title": "javascript",
                    "language": "javascript",
                    "code": "const options = {\n  method: 'POST',\n  headers: {accept: 'application/json', 'content-type': 'application/json'},\n  body: JSON.stringify({\n    title: 'string',\n    tags: {property1: 'string', property2: 'string'},\n    extra: {property1: null, property2: null},\n    closed: {a: 'string'},\n    labels: {property1: {color: 'string'}, property2: {color: 'string'}},\n    multi: {property1: 'string', property2: 'string'}\n  })\n};\n\nfetch('https://api.example.com/v1/notes', options)\n  .then(res => res.json())\n  .then(res => console.log(res))\n  .catch(err => console.error(err));"
                  },
                  {
                    "title": "python",
                    "language": "python",
                    "code": "import requests\n\nurl = \"https://api.example.com/v1/notes\"\n\npayload = {\n    \"title\": \"string\",\n    \"tags\": {\n        \"property1\": \"string\",\n        \"property2\": \"string\"\n    },\n    \"extra\": {\n        \"property1\": None,\n        \"property2\": None\n    },\n    \"closed\": { \"a\": \"string\" },\n    \"labels\": {\n        \"property1\": { \"color\": \"string\" },\n        \"property2\": { \"color\": \"string\" }\n    },\n    \"multi\": {\n        \"property1\": \"string\",\n        \"property2\": \"string\"\n    }\n}\nheaders = {\n    \"accept\": \"application/json\",\n    \"content-type\": \"application/json\"\n}\n\nresponse = requests.post(url, json=payload, headers=headers)\n\nprint(response.text)"
                  },
                  {
                    "title": "go",
                    "language": "go",
                    "code": "package main\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n\t\"net/http\"\n\t\"io\"\n)\n\nfunc main() {\n\n\turl := \"https://api.example.com/v1/notes\"\n\n\tpayload := strings.NewReader(\"{\\\"title\\\":\\\"string\\\",\\\"tags\\\":{\\\"property1\\\":\\\"string\\\",\\\"property2\\\":\\\"string\\\"},\\\"extra\\\":{\\\"property1\\\":null,\\\"property2\\\":null},\\\"closed\\\":{\\\"a\\\":\\\"string\\\"},\\\"labels\\\":{\\\"property1\\\":{\\\"color\\\":\\\"string\\\"},\\\"property2\\\":{\\\"color\\\":\\\"string\\\"}},\\\"multi\\\":{\\\"property1\\\":\\\"string\\\",\\\"property2\\\":\\\"string\\\"}}\")\n\n\treq, _ := http.NewRequest(\"POST\", url, payload)\n\n\treq.Header.Add(\"accept\", \"application/json\")\n\treq.Header.Add(\"content-type\", \"application/json\")\n\n\tres, _ := http.DefaultClient.Do(req)\n\n\tdefer res.Body.Close()\n\tbody, _ := io.ReadAll(res.Body)\n\n\tfmt.Println(string(body))\n\n}"
                  }
                ]
              }
            }
          ],
          "kind": "request"
        },
