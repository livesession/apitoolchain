  {
    "title": "Create a widget",
    "canonical": "createWidget",
    "description": "Creates a widget.",
    "type": "rest_post",
    "category": "rest",
    "context": {
      "method": "post",
      "path": "/widgets",
      "group": [
        "widgets"
      ],
