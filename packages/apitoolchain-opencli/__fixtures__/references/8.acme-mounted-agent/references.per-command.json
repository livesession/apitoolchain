  {
    "title": "agent [command]",
    "canonical": "agent",
    "description": "Run the agent CLI: every argument after `agent` is its own.",
    "category": "cli",
    "context": {
      "path": "agent",
      "fullPath": "acme agent [command] [options] [prompt]",
      "group": [
        "Commands",
        "agent"
      ]
    },
    "examples": {
      "groups": [
        {
          "examples": [
            {
              "codeblock": {
                "tabs": [
                  {
                    "title": "CLI Tool",
                    "language": "shell",
                    "code": "acme agent"
                  }
                ]
              }
            }
          ]
        },
        {
          "description": "Examples",
          "examples": [
            {
              "codeblock": {
                "tabs": [
                  {
                    "title": "CLI Tool",
                    "language": "shell",
                    "code": "acme agent\nacme agent \"Which pages are the slowest?\"\nacme agent -p \"How many orders came in today?\""
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "definitions": [
      {
        "title": "Arguments",
        "properties": [
          {
            "name": "prompt",
            "type": "string",
            "description": "A question to ask right away."
          }
        ]
      },
      {
        "title": "Options",
        "properties": [
          {
            "name": "--print",
            "type": "boolean",
            "description": "Answer once and exit, without the UI. (alias: -p)"
          },
          {
            "name": "--resume",
            "type": "string",
            "description": "Continue a conversation."
          },
          {
            "name": "--model",
            "type": "string",
            "description": "The model to answer with. (alias: -m)"
          }
        ]
      },
      {
        "title": "Commands",
        "properties": [
          {
            "name": "resume",
            "type": "command",
            "description": "Continue a conversation in the UI."
          },
          {
            "name": "history",
            "type": "command",
            "description": "Past conversations."
          }
        ]
      },
      {
        "title": "Global options",
        "properties": [
          {
            "name": "--profile",
            "type": "string",
            "description": "The profile to use. (alias: -P)"
          },
          {
            "name": "--output",
            "type": "string",
            "description": "The output format. (alias: -o)"
          }
        ]
      },
      {
        "title": "Interactive commands",
        "properties": [
          {
            "name": "new",
            "type": "command",
            "description": "Start a new conversation. (alias: clear)"
          },
          {
            "name": "model",
            "type": "command",
            "description": "Switch the model.",
            "properties": [
              {
                "name": "name",
                "type": "string",
                "description": "The model; a picker when left out."
              }
            ]
          },
          {
            "name": "export",
            "type": "command",
            "description": "Write the conversation to a file.",
            "properties": [
              {
                "name": "path",
                "type": "string",
                "description": "Where to write it.",
                "meta": [
                  {
                    "name": "required",
                    "value": "true"
                  }
                ]
              },
              {
                "name": "--format",
                "type": "string",
                "description": "The file format."
              }
            ]
          },
          {
            "name": "memory",
            "type": "command",
            "description": "What the agent remembers.",
            "properties": [
              {
                "name": "forget",
                "type": "command",
                "description": "Forget one memory.",
                "properties": [
                  {
                    "name": "id",
                    "type": "string",
                    "description": "",
                    "meta": [
                      {
                        "name": "required",
                        "value": "true"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "name": "exit",
            "type": "command",
            "description": "Leave the session. (alias: quit, q)"
          }
        ]
      },
      {
        "title": "Keys",
        "properties": [
          {
            "name": "enter",
            "type": "key",
            "description": "Send the question. (context: composer)"
          },
          {
            "name": "shift+enter, ctrl+j",
            "type": "key",
            "description": "Start a new line. (context: composer)"
          },
          {
            "name": "esc",
            "type": "key",
            "description": "Close the picker. (context: picker)"
          },
          {
            "name": "ctrl+c",
            "type": "key",
            "description": "Interrupt the answer; press again to quit."
          }
        ]
      },
      {
        "title": "Environment",
        "properties": [
          {
            "name": "ACME_AGENT_COLOR",
            "type": "string",
            "description": "The colours the UI draws with.",
            "meta": [
              {
                "name": "examples",
                "value": [
                  "truecolor",
                  "256",
                  "16",
                  "none"
                ]
              }
            ]
          },
          {
            "name": "ACME_AGENT_HOME",
            "type": "string",
            "description": "Where conversations are kept."
          }
        ]
      },
      {
        "title": "Exit codes",
        "properties": [
          {
            "name": "0",
            "type": "integer",
            "description": "Success."
          },
          {
            "name": "1",
            "type": "integer",
            "description": "The answer failed."
          },
          {
            "name": "2",
            "type": "integer",
            "description": "A usage error."
          },
          {
            "name": "130",
            "type": "integer",
            "description": "Interrupted."
          }
        ]
      }
    ]
  },
