  {
    "name": "listPets",
    "title": "List pets",
    "description": "Returns a page of pets, newest first. — GET /pets",
    "inputSchema": {
      "type": "object",
      "properties": {
        "queryParams": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of pets to return, at most 100.",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "status": {
              "type": "string",
              "description": "Only pets with this status.",
              "enum": [
                "available",
                "pending",
                "sold"
              ]
            },
            "tag": {
              "type": "array",
              "description": "Only pets carrying every one of these tags.",
              "items": {
                "type": "string"
              }
            },
            "cursor": {
              "type": "string",
              "description": "The `next_cursor` of the previous page."
            },
            "sort": {
              "type": "string",
              "description": "Sort order (use `order` instead).",
              "deprecated": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "binding": {
      "method": "GET",
      "path": "/pets",
      "fullPath": "https://api.example.com/v1/pets",
      "pathParams": [],
      "queryParams": [
        "limit",
        "status",
        "tag",
        "cursor",
        "sort"
      ],
      "body": null,
      "group": [
        "pets"
      ],
      "canonical": "listPets"
    }
  },
  {
    "name": "createPet",
    "title": "Create pet",
    "description": "Creates a pet. — POST /pets",
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestBody": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The pet's name.",
              "examples": [
                "Rex"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "available",
                "pending",
                "sold"
              ],
              "default": "available"
            },
            "tags": {
              "type": "array",
              "description": "Free-form labels.",
              "items": {
                "type": "string"
              }
            },
            "owner": {
              "type": "object",
              "description": "Who looks after the pet.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The owner's full name."
                },
                "contact": {
                  "type": "object",
                  "description": "How to reach the owner.",
                  "properties": {
                    "email": {
                      "type": "string",
                      "description": "An email address."
                    },
                    "phone": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            "vaccinated": {
              "type": "boolean",
              "default": false
            },
            "priority": {
              "type": "integer",
              "description": "Listing priority, 1 the highest.",
              "enum": [
                1,
                2,
                3
              ]
            },
            "size": {
              "type": [
                "string",
                "null"
              ],
              "description": "The pet's size; null when unknown.",
              "enum": [
                "small",
                "medium",
                "large",
                null
              ]
            },
            "attributes": {
              "type": "object",
              "description": "Free-form attributes\n====================\nStored as given, for example:\n```json\n{\n  \"color\": \"brown\",\n  \"legs\": 4\n}\n```\nKeys are case-sensitive."
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "requestBody"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "binding": {
      "method": "POST",
      "path": "/pets",
      "fullPath": "https://api.example.com/v1/pets",
      "pathParams": [],
      "queryParams": [],
      "body": "json",
      "bodyProperty": "requestBody",
      "group": [
        "pets"
      ],
      "canonical": "createPet"
    }
  },
  {
    "name": "searchPets",
    "title": "Search pets",
    "description": "Searches pets by name. — POST /pets/search",
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestBody": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to match against pet names.",
              "examples": [
                "rex"
              ]
            },
            "filters": {
              "type": "object",
              "description": "Narrow the matches; every filter must hold:\n- status\n- tags",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "pending",
                    "sold"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of matches",
              "default": 100
            }
          },
          "required": [
            "query"
          ]
        }
      },
      "required": [
        "requestBody"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "binding": {
      "method": "POST",
      "path": "/pets/search",
