  {
    "name": "placeOrder",
    "title": "Place order",
    "description": "Places an order for a pet. — POST /store/orders",
    "inputSchema": {
      "type": "object",
      "properties": {
        "headers": {
          "type": "object",
          "properties": {
            "Idempotency-Key": {
              "type": "string",
              "description": "Retries with the same key place one order."
            }
          },
          "additionalProperties": false
        },
        "requestBody": {
          "type": "object",
          "properties": {
            "pet_id": {
              "type": "string",
              "description": "The pet to order."
            },
            "quantity": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "payment": {
              "description": "How the order is paid.",
              "oneOf": [
                {
                  "type": "object",
                  "title": "Card",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "card"
                      ],
                      "const": "card"
                    },
                    "token": {
                      "type": "string",
                      "description": "A card token from the payment form."
                    }
                  },
                  "required": [
                    "type",
                    "token"
                  ]
                },
                {
                  "type": "object",
                  "title": "Transfer",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "transfer"
                      ],
                      "const": "transfer"
                    },
                    "iban": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "iban"
                  ]
                }
              ]
            },
            "note": {
              "description": "A note for the shop.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "required": [
            "pet_id",
            "payment"
          ]
        }
      },
      "required": [
        "requestBody"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "binding": {
      "method": "POST",
      "path": "/store/orders",
      "fullPath": "https://api.example.com/v1/store/orders",
      "pathParams": [],
      "queryParams": [],
      "body": "json",
      "bodyProperty": "requestBody",
      "group": [
        "store"
      ],
      "canonical": "placeOrder"
    }
  },
