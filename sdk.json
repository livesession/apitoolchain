{
  "$schema": "https://unpkg.com/@xyd-js/opensdk-schemas/chain.schema.json",
  "version": 1,
  "sources": {
    "gitprovider": {
      "inputs": [
        {
          "location": "apps/gitprovider/openapi/__generated__/openapi.yaml"
        }
      ],
      "output": ".chain/gitprovider.openapi.json"
    },
    "registry-api": {
      "inputs": [
        {
          "location": "apps/registry-api/openapi/v1/__generated__/openapi.yaml"
        }
      ],
      "output": ".chain/registry-api.openapi.json"
    },
    "api": {
      "inputs": [
        {
          "location": "apps/api/openapi/v1/__generated__/openapi.yaml"
        }
      ],
      "output": ".chain/api.openapi.json"
    }
  },
  "targets": {
    "gitprovider-node": {
      "target": "node",
      "source": "gitprovider",
      "output": "packages/apitoolchainapp-gitprovider-node",
      "sdkName": "gitprovider",
      "options": {
        "packageName": "@apitoolchain/gitprovider-node",
        "tests": false,
        "entry": "source"
      }
    },
    "registry-api-node": {
      "target": "node",
      "source": "registry-api",
      "output": "packages/apitoolchainapp-registry-api-node",
      "sdkName": "registry-api",
      "options": {
        "packageName": "@apitoolchain/registry-api-node",
        "tests": false,
        "busybox": "flat",
        "entry": "source"
      }
    },
    "api-node": {
      "target": "node",
      "source": "api",
      "output": "packages/apitoolchainapp-api-node",
      "sdkName": "api",
      "options": {
        "packageName": "@apitoolchain/api-node",
        "tests": false,
        "entry": "source"
      }
    },
    "api-cli": {
      "target": "rust-cli",
      "source": "api",
      "output": "cli",
      "format": true,
      "options": {
        "cliName": "api",
        "grammar": "verb-noun",
        "singularOverrides": {
          "apis": "api"
        },
        "versionFrom": "crate"
      }
    }
  }
}
