# The pin. Everything build.sh does derives from these lines.
#
# UPSTREAM_SHA is the commit the `cmd/openapi` MODULE is published at
# (proxy.golang.org/.../cmd/openapi/@latest), which is NOT the commit its own
# go.mod pins the parent library to. We build the module AS PUBLISHED and let
# its go.mod choose the parent — GOWORK=off is what makes that true.
UPSTREAM_REPO=https://github.com/speakeasy-api/openapi
UPSTREAM_SHA=285dc0f5a0aa3eda2e241e3c855dc7c5d3d7d50c
UPSTREAM_REF=v1.25.2
UPSTREAM_MODVER=v0.0.0-20260921021909-285dc0f5a0aa

# EXACT, not a floor: Go's output is byte-stable per toolchain, not across them.
GO_VERSION=1.26.8

# The two shimmed modules. build.sh HARD-FAILS if either resolves to a
# different version — a shim written against one version silently miscompiling
# against another is the one failure here that would not be loud.
PIN_BUBBLETEA=charm.land/bubbletea/v2@v2.0.9
PIN_CLIPBOARD=github.com/atotto/clipboard@v0.1.4
